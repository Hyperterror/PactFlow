// PactFlow — Prisma schema
//
// This schema is the single source of truth for the data model. The local
// development datasource is SQLite so the platform runs with zero external
// services; `npm run db:pg-schema` derives `prisma/schema.postgres.prisma`
// (identical models, PostgreSQL datasource) for production deployments.
//
// Retention: AuditLog and WebhookEvent are append-only. They must be retained
// for a minimum of 2 years (Requirement 24.5) — no delete paths exist in the
// application code, and purge jobs must respect the retention window.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum BriefStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum QuotationStatus {
  AI_DRAFT
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AgreementStatus {
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ApprovalState {
  PENDING
  APPROVED
}

enum ChangeRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ScopeLabel {
  INCLUDED
  OUTSIDE_SCOPE
  AMBIGUOUS
}

enum MilestoneStatus {
  PENDING
  DELIVERED
  APPROVED
  OVERDUE
}

enum DeliverableStatus {
  UPLOADING
  UPLOADED
  REVISION_REQUESTED
  APPROVED
  PROCESSING_FAILED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REVIEW_REQUIRED
}

// Engagement lifecycle (Lifecycle Update PRD section 8). Selection opens
// DISCOVERY; the first saved requirements version moves it to REQUIREMENTS;
// mutual approval of one exact version moves it to REQUIREMENTS_APPROVED;
// submitting the SOW creates the Agreement and moves it to AGREEMENT. From
// there the Agreement owns the detailed state (ACTIVE / COMPLETED).
enum EngagementStatus {
  DISCOVERY
  REQUIREMENTS
  REQUIREMENTS_APPROVED
  AGREEMENT
  CANCELLED
}

enum DiscoveryTermsType {
  UNPAID
  TIME_BOXED
  PAID
}

// A saved requirements version is immutable. IN_REVIEW -> APPROVED when both
// parties approve it; any version a newer one replaces becomes SUPERSEDED.
enum RequirementsVersionStatus {
  IN_REVIEW
  APPROVED
  SUPERSEDED
}

// Freelancer payout after a verified capture (PayPal Payouts API).
// AWAITING_RECEIVER: captured, but the Freelancer has not added a PayPal email.
// PENDING: submitted to PayPal, item not final yet. SUCCEEDED / UNCLAIMED /
// FAILED mirror the payout item's transaction status (UNCLAIMED = PayPal holds
// it until the receiver signs up; it returns to the sender after 30 days).
enum PayoutStatus {
  AWAITING_RECEIVER
  PENDING
  SUCCEEDED
  UNCLAIMED
  FAILED
}

enum WorkingPreferenceStatus {
  PENDING_ACKNOWLEDGEMENT
  CONFIRMED
}

enum NotificationType {
  INVITATION_RECEIVED
  INVITATION_REVOKED
  QUOTATION_SUBMITTED
  QUOTATION_WITHDRAWN
  COMMENT_POSTED
  AGREEMENT_READY
  AGREEMENT_ACTIVE
  CHANGE_REQUEST_SUBMITTED
  CHANGE_REQUEST_CLASSIFIED
  CHANGE_REQUEST_VOTED
  CHANGE_REQUEST_REMINDER
  CHANGE_REQUEST_EXPIRED
  MILESTONE_DELIVERED
  MILESTONE_OVERDUE
  DELIVERABLE_REVIEW_NEEDED
  DELIVERABLE_REMINDER
  PAYMENT_CAPTURED
  SCOPE_CLASSIFICATION_FAILED
  DISCUSSION_MESSAGE
  DELIVERABLE_REVIEWED
  COLLABORATION_READY
  PAYOUT_SENT
  PAYOUT_FAILED
  PAYOUT_ACCOUNT_NEEDED
  ENGAGEMENT_CREATED
  ENGAGEMENT_MESSAGE
  ENGAGEMENT_CANCELLED
  REQUIREMENTS_VERSION_CREATED
  REQUIREMENTS_COMMENT
  REQUIREMENTS_APPROVED
}

// ─── Core Entities ────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  displayName       String
  passwordHash      String
  // Where PayPal Payouts sends this user's earnings as a Freelancer.
  paypalPayoutEmail String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions                  Session[]
  loginAttempts             LoginAttempt[]
  briefsAsClient            Brief[]
  invitationsSent           Invitation[]           @relation("InvitationClient")
  invitationsReceived       Invitation[]           @relation("InvitationFreelancer")
  quotations                Quotation[]
  agreementApprovals        AgreementApproval[]
  changeRequests            ChangeRequest[]        @relation("ChangeRequestSubmitter")
  changeRequestVotes        ChangeRequestVote[]
  scopeDisputes             ScopeLabelDispute[]
  discussionMessages        DiscussionMessage[]
  deliverables              Deliverable[]
  revisionRequests          RevisionRequest[]
  paymentsMade              Payment[]              @relation("PaymentClient")
  notifications             Notification[]
  auditActorEntries         AuditLog[]
  collaborationAsClient     CollaborationHistory[] @relation("CollabClient")
  collaborationAsFreelancer CollaborationHistory[] @relation("CollabFreelancer")
  workingPreferences        WorkingPreference[]
  collaborationSummaries    CollaborationSummary[]
  signedUrlEvents           SignedUrlEvent[]
  comparisonAnnotations     ComparisonAnnotation[]
  quotationComments         QuotationComment[]
  projectTemplates          ProjectTemplate[]
  passwordResetTokens       PasswordResetToken[]
  payoutsReceived           Payout[]
  engagementsAsClient       Engagement[]           @relation("EngagementClient")
  engagementsAsFreelancer   Engagement[]           @relation("EngagementFreelancer")
  engagementMessages        EngagementMessage[]
  requirementsVersions      RequirementsVersion[]
  requirementsApprovals     RequirementsApproval[]
  requirementsComments      RequirementsComment[]

  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  startedAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model LoginAttempt {
  id          String    @id @default(cuid())
  email       String
  userId      String?
  success     Boolean
  attemptedAt DateTime  @default(now())
  lockedUntil DateTime?
  user        User?     @relation(fields: [userId], references: [id])

  @@index([email, attemptedAt])
}

/// Account recovery. Only a SHA-256 hash of the token is stored, so a database
/// leak does not hand out working reset links. Tokens are single use and expire.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model Brief {
  id                String      @id @default(cuid())
  clientId          String
  title             String
  description       String
  deliverables      Json // string[] — 1..20 deliverable descriptions
  budgetMin         Decimal
  budgetMax         Decimal
  targetDate        DateTime
  status            BriefStatus @default(DRAFT)
  publishedAt       DateTime?
  projectTemplateId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  client              User                 @relation(fields: [clientId], references: [id])
  projectTemplate     ProjectTemplate?     @relation(fields: [projectTemplateId], references: [id])
  invitations         Invitation[]
  quotations          Quotation[]
  agreements          Agreement[]
  engagements         Engagement[]
  comparisonWorkspace ComparisonWorkspace?

  @@index([clientId, createdAt])
}

model Invitation {
  id                  String           @id @default(cuid())
  briefId             String
  clientId            String
  freelancerId        String
  token               String           @unique @default(cuid())
  status              InvitationStatus @default(PENDING)
  // Repeat-engagement context attached at send time (Requirement 22.5).
  attachmentSummaryId String?
  attachmentHistoryId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  brief      Brief @relation(fields: [briefId], references: [id])
  client     User  @relation("InvitationClient", fields: [clientId], references: [id])
  freelancer User  @relation("InvitationFreelancer", fields: [freelancerId], references: [id])

  @@unique([briefId, freelancerId])
  @@index([freelancerId, status])
}

model Quotation {
  id                String          @id @default(cuid())
  briefId           String
  freelancerId      String
  status            QuotationStatus @default(AI_DRAFT)
  lineItems         Json // QuotationLineItem[]
  timelineDays      Int
  notes             String
  aiDraftSnapshot   Json? // Original AI values preserved for audit
  aiSourcedFields   Json? // Which fields were accepted unchanged from AI
  dismissedPricing  Json? // Line-item indices whose recommendation was dismissed
  submittedAt       DateTime?
  regenerationCount Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  brief           Brief              @relation(fields: [briefId], references: [id])
  freelancer      User               @relation(fields: [freelancerId], references: [id])
  comments        QuotationComment[]
  agreements      Agreement[]
  engagement      Engagement?
  comparisonItems ComparisonItem[]

  @@index([briefId, submittedAt])
}

model QuotationComment {
  id                     String    @id @default(cuid())
  quotationId            String
  authorId               String
  content                String
  editedAt               DateTime?
  isClarificationRequest Boolean   @default(false)
  clarificationStatus    String? // OPEN | RESOLVED
  answeredByCommentId    String?
  createdAt              DateTime  @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])

  @@index([quotationId, createdAt])
}

model Agreement {
  id             String          @id @default(cuid())
  briefId        String
  quotationId    String
  clientId       String
  freelancerId   String
  status         AgreementStatus @default(PENDING_APPROVAL)
  currentVersion Int             @default(1)
  revisionLimit  Int             @default(3)
  currency       String          @default("USD")
  startDate      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  brief              Brief               @relation(fields: [briefId], references: [id])
  quotation          Quotation           @relation(fields: [quotationId], references: [id])
  versions           AgreementVersion[]
  approvals          AgreementApproval[]
  milestones         Milestone[]
  changeRequests     ChangeRequest[]
  discussionMessages DiscussionMessage[]
  engagement         Engagement?

  @@index([clientId])
  @@index([freelancerId])
}

model AgreementVersion {
  id                    String   @id @default(cuid())
  agreementId           String
  versionNumber         Int
  content               Json // Full immutable snapshot of agreement terms
  authorId              String
  authorRole            String // CLIENT | FREELANCER | PLATFORM
  // Traceability to the approved requirements baseline the SOW was built from.
  // Null for versions created without an Engagement (amendments copy it).
  requirementsVersionId String?
  createdAt             DateTime @default(now())

  agreement           Agreement            @relation(fields: [agreementId], references: [id])
  requirementsVersion RequirementsVersion? @relation(fields: [requirementsVersionId], references: [id])
  approvals           AgreementApproval[]
  milestones          Milestone[]
  payments            Payment[]

  @@unique([agreementId, versionNumber]) // Enforces monotonicity invariant at DB level
  @@index([agreementId, versionNumber])
}

model AgreementApproval {
  id            String        @id @default(cuid())
  agreementId   String
  versionId     String
  versionNumber Int
  actorId       String
  actorRole     String // CLIENT | FREELANCER
  state         ApprovalState @default(PENDING)
  approvedAt    DateTime?
  retractedAt   DateTime?
  createdAt     DateTime      @default(now())

  agreement Agreement        @relation(fields: [agreementId], references: [id])
  version   AgreementVersion @relation(fields: [versionId], references: [id])
  actor     User             @relation(fields: [actorId], references: [id])

  @@unique([agreementId, versionNumber, actorRole])
}

model ChangeRequest {
  id                  String              @id @default(cuid())
  agreementId         String
  submitterId         String
  discussionMessageId String              @unique
  status              ChangeRequestStatus @default(SUBMITTED)
  scopeLabel          ScopeLabel?
  scopeRationale      String?
  // Baseline items the label relied on: [{ ref, relation, text, matchedTerms }].
  scopeEvidence       Json?
  // e.g. "Requirements v3 + Agreement v1 (SOW)"
  scopeBaseline       String?
  scopeClassifiedAt   DateTime?
  responseDeadline    DateTime
  reminderSentAt      DateTime?
  clientVote          String? // APPROVE | REJECT
  freelancerVote      String?
  clientVotedAt       DateTime?
  freelancerVotedAt   DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  agreement         Agreement           @relation(fields: [agreementId], references: [id])
  submitter         User                @relation("ChangeRequestSubmitter", fields: [submitterId], references: [id])
  discussionMessage DiscussionMessage   @relation(fields: [discussionMessageId], references: [id])
  votes             ChangeRequestVote[]
  disputes          ScopeLabelDispute[]

  @@index([agreementId, status])
}

model ChangeRequestVote {
  id              String    @id @default(cuid())
  changeRequestId String
  actorId         String
  actorRole       String // CLIENT | FREELANCER
  vote            String // APPROVE | REJECT
  retractedAt     DateTime?
  createdAt       DateTime  @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id])
  actor         User          @relation(fields: [actorId], references: [id])
}

model ScopeLabelDispute {
  id              String   @id @default(cuid())
  changeRequestId String
  actorId         String
  justification   String
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id])
  actor         User          @relation(fields: [actorId], references: [id])
}

model DiscussionMessage {
  id              String   @id @default(cuid())
  agreementId     String
  authorId        String
  content         String
  isScopeProposal Boolean  @default(false)
  createdAt       DateTime @default(now())

  agreement     Agreement      @relation(fields: [agreementId], references: [id])
  author        User           @relation(fields: [authorId], references: [id])
  changeRequest ChangeRequest?

  @@index([agreementId, createdAt])
}

model Milestone {
  id                 String          @id @default(cuid())
  agreementId        String
  agreementVersionId String
  name               String
  description        String
  dueDate            DateTime
  paymentAmount      Decimal
  status             MilestoneStatus @default(PENDING)
  deliveredAt        DateTime?
  approvedAt         DateTime?
  overdueNotifiedAt  DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  agreement        Agreement        @relation(fields: [agreementId], references: [id])
  agreementVersion AgreementVersion @relation(fields: [agreementVersionId], references: [id])
  deliverables     Deliverable[]
  payment          Payment?

  @@index([agreementId, dueDate, createdAt])
}

model Deliverable {
  id            String            @id @default(cuid())
  milestoneId   String
  freelancerId  String
  versionNumber Int               @default(1)
  status        DeliverableStatus @default(UPLOADING)
  originalKey   String            @unique // Storage key — never exposed in API responses
  previewKey    String            @unique // Independent of originalKey
  originalHash  String // SHA-256 hex
  previewHash   String? // SHA-256 hex of preview
  fileName      String
  fileSizeBytes Int
  uploadedAt    DateTime          @default(now())
  revisionCount Int               @default(0)
  updatedAt     DateTime          @updatedAt

  milestone       Milestone         @relation(fields: [milestoneId], references: [id])
  freelancer      User              @relation(fields: [freelancerId], references: [id])
  revisions       RevisionRequest[]
  payment         Payment?
  signedUrlEvents SignedUrlEvent[]

  @@index([milestoneId, versionNumber])
}

model RevisionRequest {
  id            String   @id @default(cuid())
  deliverableId String
  clientId      String
  feedbackText  String
  createdAt     DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])
  client      User        @relation(fields: [clientId], references: [id])

  @@index([deliverableId])
}

model Payment {
  id                 String        @id @default(cuid())
  milestoneId        String        @unique
  deliverableId      String?       @unique
  agreementVersionId String
  clientId           String
  status             PaymentStatus @default(PENDING)
  amountExpected     Decimal
  amountCaptured     Decimal?
  currency           String        @default("USD")
  currencyCaptured   String? // Currency PayPal reported on the capture itself
  paypalOrderId      String?       @unique
  paypalCaptureId    String?       @unique // purchase_units[0].payments.captures[0].id
  paypalStatus       String? // Status of the capture (not the order) once one exists
  approveUrl         String?
  idempotencyKey     String        @unique // Per-attempt key
  capturedAt         DateTime?
  captureResponse    Json? // Full PayPal capture API response
  reviewFlag         Boolean       @default(false)
  lastError          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  milestone        Milestone        @relation(fields: [milestoneId], references: [id])
  deliverable      Deliverable?     @relation(fields: [deliverableId], references: [id])
  agreementVersion AgreementVersion @relation(fields: [agreementVersionId], references: [id])
  client           User             @relation("PaymentClient", fields: [clientId], references: [id])
  payout           Payout?

  @@index([idempotencyKey])
}

/// The Freelancer's share of one captured milestone payment, sent with the
/// PayPal Payouts API. One per Payment; `senderBatchId` is derived from the
/// payment, so a retry can never pay twice.
model Payout {
  id            String       @id @default(cuid())
  paymentId     String       @unique
  milestoneId   String
  freelancerId  String
  status        PayoutStatus @default(AWAITING_RECEIVER)
  receiverEmail String?
  grossAmount   Decimal // amount captured from the Client
  platformFee   Decimal
  amount        Decimal // grossAmount - platformFee, sent to the Freelancer
  currency      String       @default("USD")
  senderBatchId String       @unique
  paypalBatchId String?      @unique
  paypalItemId  String?      @unique
  paypalStatus  String? // payout item transaction_status as PayPal reported it
  lastError     String?
  attempts      Int          @default(0)
  submittedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  payment    Payment @relation(fields: [paymentId], references: [id])
  freelancer User    @relation(fields: [freelancerId], references: [id])

  @@index([freelancerId, status])
  @@index([status, updatedAt])
}

model WebhookEvent {
  id                String    @id @default(cuid())
  paypalEventId     String    @unique // Idempotency key
  eventType         String
  rawPayload        Json
  signatureVerified Boolean
  isDuplicate       Boolean   @default(false)
  processedAt       DateTime?
  processingError   String?
  receivedAt        DateTime  @default(now())

  @@index([eventType, receivedAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  eventType     String
  actorId       String
  resourceId    String
  resourceType  String
  previousState String?
  newState      String
  metadata      Json?
  createdAt     DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  // Append-only: no update or delete paths exist in the application
  @@index([resourceId, resourceType, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  payload     Json
  deliveredAt DateTime?
  retryCount  Int              @default(0)
  guaranteed  Boolean          @default(false)
  escalatedAt DateTime?
  lastError   String?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, deliveredAt, createdAt])
}

model CollaborationHistory {
  id                 String   @id @default(cuid())
  clientId           String
  freelancerId       String
  agreementId        String   @unique
  agreementSnapshot  Json // Immutable snapshot of completed AgreementVersion
  deliverables       Json // Approved deliverable summaries
  completedAt        DateTime
  totalPaymentAmount Decimal
  createdAt          DateTime @default(now())

  client      User                   @relation("CollabClient", fields: [clientId], references: [id])
  freelancer  User                   @relation("CollabFreelancer", fields: [freelancerId], references: [id])
  preferences WorkingPreference[]
  summaries   CollaborationSummary[]
  templates   ProjectTemplate[]

  @@index([clientId, freelancerId])
}

model WorkingPreference {
  id                   String                  @id @default(cuid())
  historyId            String
  authorId             String
  statement            String
  status               WorkingPreferenceStatus @default(PENDING_ACKNOWLEDGEMENT)
  authorAcknowledgedAt DateTime?
  acknowledgedBy       String? // other party's user id
  acknowledgedAt       DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  history CollaborationHistory @relation(fields: [historyId], references: [id])
  author  User                 @relation(fields: [authorId], references: [id])

  @@index([historyId, status])
}

model CollaborationSummary {
  id                String   @id @default(cuid())
  historyId         String
  requestorId       String
  content           Json // CollaborationSummarySchema output
  generatedAt       DateTime @default(now())
  flaggedStatements Json? // Array of {statementIndex, flaggedByUserId, flaggedAt}

  history   CollaborationHistory @relation(fields: [historyId], references: [id])
  requestor User                 @relation(fields: [requestorId], references: [id])

  @@index([historyId, generatedAt])
}

model ProjectTemplate {
  id           String   @id @default(cuid())
  historyId    String
  clientId     String
  name         String
  templateData Json // Agreement structure, milestone config, deliverable types
  createdAt    DateTime @default(now())

  history CollaborationHistory @relation(fields: [historyId], references: [id])
  client  User                 @relation(fields: [clientId], references: [id])
  briefs  Brief[]

  @@index([clientId])
}

model SignedUrlEvent {
  id            String    @id @default(cuid())
  clientId      String
  deliverableId String
  generatedAt   DateTime  @default(now())
  expiresAt     DateTime
  invalidatedAt DateTime? // Set when role changes trigger early invalidation

  client      User        @relation(fields: [clientId], references: [id])
  deliverable Deliverable @relation(fields: [deliverableId], references: [id])

  @@index([deliverableId, generatedAt])
}

model ComparisonWorkspace {
  id         String    @id @default(cuid())
  briefId    String    @unique
  clientId   String
  selections Json // Array of quotation IDs currently in comparison
  aiSummary  Json?
  exportedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  brief       Brief                  @relation(fields: [briefId], references: [id])
  annotations ComparisonAnnotation[]
}

model ComparisonItem {
  id          String   @id @default(cuid())
  workspaceId String
  quotationId String
  addedAt     DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@unique([workspaceId, quotationId])
}

model ComparisonAnnotation {
  id          String   @id @default(cuid())
  workspaceId String
  quotationId String
  attribute   String
  noteText    String
  clientId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace ComparisonWorkspace @relation(fields: [workspaceId], references: [id])
  client    User                @relation(fields: [clientId], references: [id])

  @@unique([workspaceId, quotationId, attribute])
}

// --- Engagement & requirements (Lifecycle Update PRD) ------------------------

/// The parent record between proposal selection and the final Agreement.
/// Selecting a proposal creates exactly one Engagement for that quotation; it
/// owns discovery discussion and the versioned requirements brief (BRD). The
/// Agreement is created only from an approved BRD version plus the SOW.
model Engagement {
  id                         String             @id @default(cuid())
  briefId                    String
  quotationId                String             @unique
  clientId                   String
  freelancerId               String
  status                     EngagementStatus   @default(DISCOVERY)
  discoveryType              DiscoveryTermsType @default(UNPAID)
  discoveryFee               Decimal?
  discoveryDays              Int?
  discoveryNotes             String?
  currentRequirementsVersion Int                @default(0)
  agreementId                String?            @unique
  selectedAt                 DateTime           @default(now())
  cancelledAt                DateTime?
  cancelReason               String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  brief                 Brief                  @relation(fields: [briefId], references: [id])
  quotation             Quotation              @relation(fields: [quotationId], references: [id])
  client                User                   @relation("EngagementClient", fields: [clientId], references: [id])
  freelancer            User                   @relation("EngagementFreelancer", fields: [freelancerId], references: [id])
  agreement             Agreement?             @relation(fields: [agreementId], references: [id])
  messages              EngagementMessage[]
  requirementsVersions  RequirementsVersion[]
  requirementsApprovals RequirementsApproval[]
  requirementsComments  RequirementsComment[]

  @@index([briefId, status])
  @@index([clientId])
  @@index([freelancerId])
}

/// Discovery discussion. It needs no Agreement, so none is created early.
model EngagementMessage {
  id           String   @id @default(cuid())
  engagementId String
  authorId     String
  content      String
  createdAt    DateTime @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id])
  author     User       @relation(fields: [authorId], references: [id])

  @@index([engagementId, createdAt])
}

/// One immutable snapshot of the requirements brief. Editing never mutates a
/// row: it creates the next version number, and the unique constraint guards
/// the sequence at the database level, exactly like AgreementVersion.
model RequirementsVersion {
  id            String                    @id @default(cuid())
  engagementId  String
  versionNumber Int
  content       Json // RequirementsContent: sections with stable IDs and source refs
  authorId      String
  authorRole    String // CLIENT | FREELANCER
  status        RequirementsVersionStatus @default(IN_REVIEW)
  // "llm" | "heuristic" when the saved text started from an AI draft, else "manual".
  draftEngine   String                    @default("manual")
  changeSummary String?
  createdAt     DateTime                  @default(now())
  approvedAt    DateTime?
  supersededAt  DateTime?

  engagement        Engagement             @relation(fields: [engagementId], references: [id])
  author            User                   @relation(fields: [authorId], references: [id])
  approvals         RequirementsApproval[]
  comments          RequirementsComment[]
  agreementVersions AgreementVersion[]

  @@unique([engagementId, versionNumber])
}

/// One approval per party per exact version. Approving N never approves N+1.
model RequirementsApproval {
  id            String   @id @default(cuid())
  engagementId  String
  versionId     String
  versionNumber Int
  actorId       String
  actorRole     String // CLIENT | FREELANCER
  approvedAt    DateTime @default(now())

  engagement Engagement          @relation(fields: [engagementId], references: [id])
  version    RequirementsVersion @relation(fields: [versionId], references: [id])
  actor      User                @relation(fields: [actorId], references: [id])

  @@unique([versionId, actorRole])
}

/// Review comments anchored to a version and, optionally, one requirement ID.
model RequirementsComment {
  id            String    @id @default(cuid())
  engagementId  String
  versionId     String
  requirementId String?
  authorId      String
  body          String
  status        String    @default("OPEN") // OPEN | RESOLVED
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  engagement Engagement          @relation(fields: [engagementId], references: [id])
  version    RequirementsVersion @relation(fields: [versionId], references: [id])
  author     User                @relation(fields: [authorId], references: [id])

  @@index([versionId, createdAt])
}
