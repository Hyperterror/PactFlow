# Local development environment (SQLite + on-disk storage + mock PayPal + heuristic AI)
DATABASE_URL="file:./dev.db"

AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
AUTH_TRUST_HOST="true"

# Storage: "local" writes to LOCAL_STORAGE_DIR; "s3" uses the S3_* values.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".data/storage"
STORAGE_SIGNING_SECRET="dev-only-storage-signing-secret"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="pactflow-deliverables"

# PayPal: "mock" simulates the Orders v2 Sandbox locally; "sandbox" calls the real API.
PAYPAL_MODE="mock"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID=""
PAYPAL_WEBHOOK_SECRET="dev-only-webhook-secret"

# LLM: when LLM_API_KEY is empty the deterministic heuristic engine is used.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

APP_URL="http://localhost:3000"

# Shared secret for GET/POST /api/cron. Left empty, the endpoint only accepts
# an authenticated platform operator (OPERATOR_EMAILS below).
CRON_SECRET=""

# Comma-separated operator emails allowed to read /api/audit and run cron jobs.
OPERATOR_EMAILS=""
